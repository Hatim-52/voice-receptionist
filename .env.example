# ==============================================================================
# Voice AI Doctor Appointment Assistant - Environment Configuration
# ==============================================================================

# 1. ElevenLabs API Key (used for Realtime STT and natural TTS)
# Get your key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID
# Default is 'Rachel' (clear, professional clinic receptionist): 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 2. Google Gemini API Key (free tier quota)
# Get your key from Google AI Studio: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# 3. Google Gemini Model Name
# Default recommended fast flash model: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
